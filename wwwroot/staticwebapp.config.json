{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/img/*",
      "/content/*",
      "/lib/*",
      "/_framework/*",
      "*.{png,jpg,jpeg,webp,avif,ico,svg,css,js,json,wasm}"
    ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".webp": "image/webp",
    ".avif": "image/avif"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  }
}
