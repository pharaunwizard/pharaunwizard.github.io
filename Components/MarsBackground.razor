<div class="mars-bg" aria-hidden="true">
    <div class="mars-bg__glow"></div>
    <div class="mars-bg__dust">
        @foreach (var p in Particles)
        {
            <span class="mars-bg__particle"
                  style="@($"--x:{p.X}%;--y:{p.Y}%;--s:{p.Size}px;--dur:{p.Duration}s;--delay:{p.Delay}s")"></span>
        }
    </div>
</div>

@code {
    private sealed record Dust(double X, double Y, double Size, double Duration, double Delay);

    private static readonly Dust[] Particles =
    {
        new(4, 88, 3, 26, 0),
        new(12, 62, 2, 34, 4),
        new(19, 30, 4, 30, 9),
        new(27, 74, 2, 40, 2),
        new(35, 18, 3, 28, 6),
        new(43, 55, 2, 36, 12),
        new(51, 82, 4, 32, 3),
        new(58, 40, 2, 42, 8),
        new(66, 12, 3, 30, 1),
        new(73, 68, 2, 38, 10),
        new(81, 34, 4, 26, 5),
        new(88, 78, 3, 44, 7),
        new(94, 50, 2, 34, 11),
        new(62, 90, 2, 40, 13)
    };
}
