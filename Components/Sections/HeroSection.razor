@inject ContentService Content

<section class="hero section" id="hero" aria-labelledby="hero-title">
    <div class="hero__particles" aria-hidden="true">
        @foreach (var particle in Particles)
        {
            <span class="hero__particle hero__particle--@particle.Tint"
                  style="@($"--x:{particle.X}%;--y:{particle.Y}%;--s:{particle.Size}px;--dur:{particle.Duration}s;--delay:{particle.Delay}s;--dx1:{particle.Dx1}px;--dy1:{particle.Dy1}px;--dx2:{particle.Dx2}px;--dy2:{particle.Dy2}px;--dx3:{particle.Dx3}px;--dy3:{particle.Dy3}px")"></span>
        }
    </div>
    <div class="container hero__inner">
        @if (profile is null)
        {
            <div class="skeleton hero__skeleton" aria-hidden="true"></div>
        }
        else
        {
            <div class="hero__photo">
                <img src="@profile.PhotoUrl" alt="@($"Фото — {profile.Name}")" width="320" height="400" decoding="async" fetchpriority="high" />
            </div>
            <div class="hero__content">
                <h1 id="hero-title" class="hero__name">@profile.Name</h1>
                <p class="hero__role">@profile.Role</p>
                <p class="hero__offer">@profile.Offer</p>
                <div class="hero__actions">
                    @if (hh is not null)
                    {
                        @if (IsUnavailable(hh.Url))
                        {
                            <button type="button" class="btn btn--accent hero__cta" @onclick="() => hhUnavailable = true">
                                Резюме на hh.ru
                            </button>
                        }
                        else
                        {
                            <a class="btn btn--accent hero__cta" href="@hh.Url" target="_blank" rel="noopener noreferrer">
                                Резюме на hh.ru
                            </a>
                        }
                    }
                    <a class="hero__scroll" href="#about">
                        Подробнее
                        <span class="hero__scroll-arrow" aria-hidden="true">↓</span>
                    </a>
                </div>
                @if (hhUnavailable)
                {
                    <p class="hero__notice" role="status">Резюме на hh.ru пока недоступно</p>
                }
            </div>
        }
    </div>
</section>

@code {
    private sealed record Particle(
        double X, double Y, double Size, double Duration, double Delay,
        double Dx1, double Dy1, double Dx2, double Dy2, double Dx3, double Dy3,
        string Tint);

    private static readonly Particle[] Particles =
    {
        new(6, 72, 5, 16, 0, 18, -22, 32, 6, 12, 24, "warm"),
        new(16, 28, 4, 20, 3, -14, -18, -24, 10, -6, 22, "cool"),
        new(28, 58, 7, 18, 6, 22, 14, 6, 30, -16, 12, "warm"),
        new(41, 18, 4, 22, 1, -20, 16, -8, 30, 10, 8, "cool"),
        new(55, 74, 6, 17, 8, 16, -24, -10, -30, -22, 4, "warm"),
        new(68, 36, 4, 21, 4, -18, -20, 8, -14, 20, 14, "cool"),
        new(80, 62, 7, 19, 9, 20, 18, 24, -8, 4, -26, "warm"),
        new(92, 24, 5, 23, 5, -16, 22, -26, 6, -10, -18, "warm")
    };

    private Profile? profile;
    private ContactLink? hh;
    private bool hhUnavailable;

    protected override async Task OnInitializedAsync()
    {
        profile = await Content.GetProfileAsync();
        hh = profile?.Contacts.FirstOrDefault(c => c.Type == "hh");
    }

    private static bool IsUnavailable(string? url)
        => string.IsNullOrWhiteSpace(url);
}
