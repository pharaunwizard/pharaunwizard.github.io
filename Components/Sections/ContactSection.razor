@inject ContentService Content

<section class="section contacts" id="contacts" aria-labelledby="contacts-title">
    <div class="container">
        <h2 id="contacts-title" class="section__title">Контакты</h2>
        @if (profile is null)
        {
            <div class="skeleton contacts__skeleton" aria-hidden="true"></div>
        }
        else if (profile.Contacts.Count == 0)
        {
            <p class="empty-state">Контакты пока не указаны.</p>
        }
        else
        {
            <p class="contacts__intro">Открыт к предложениям и сотрудничеству. Свяжитесь удобным способом:</p>
            <ul class="contacts__list">
                @foreach (var contact in profile.Contacts)
                {
                    <li class="contact contact--@contact.Type">
                        @if (IsEmail(contact))
                        {
                            <a class="contact__link" href="#" data-type="@contact.Type" data-mail="@MailData(contact)">
                                <ContactIcon Type="@contact.Type" />
                                <span class="contact__label">@contact.Label</span>
                            </a>
                        }
                        else
                        {
                            <a class="contact__link" href="@contact.Url" data-type="@contact.Type" target="_blank" rel="noopener noreferrer">
                                <ContactIcon Type="@contact.Type" />
                                <span class="contact__label">@contact.Label</span>
                            </a>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private Profile? profile;

    protected override async Task OnInitializedAsync()
    {
        profile = await Content.GetProfileAsync();
    }

    private static bool IsEmail(ContactLink contact)
        => contact.Type.Equals("email", StringComparison.OrdinalIgnoreCase)
           || contact.Url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase);

    // Адрес кодируется (base64), чтобы не хранить email открытым текстом в DOM;
    // декодирование и запуск mailto происходят синхронно в обработчике клика (app.js).
    private static string MailData(ContactLink contact)
    {
        var address = contact.Url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase)
            ? contact.Url["mailto:".Length..]
            : contact.Url;

        return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(address));
    }
}
