@inject ContentService Content

<section class="section contacts" id="contacts" aria-labelledby="contacts-title">
    <div class="container">
        <h2 id="contacts-title" class="section__title">Контакты</h2>
        @if (profile is null)
        {
            <div class="skeleton contacts__skeleton" aria-hidden="true"></div>
        }
        else if (profile.Contacts.Count == 0)
        {
            <p class="empty-state">Контакты пока не указаны.</p>
        }
        else
        {
            <p class="contacts__intro">Открыт к предложениям и сотрудничеству. Свяжитесь удобным способом:</p>
            <ul class="contacts__list">
                @foreach (var contact in profile.Contacts)
                {
                    <li class="contact contact--@contact.Type">
                        <a class="contact__link"
                           href="@contact.Url"
                           data-type="@contact.Type"
                           target="@(IsExternal(contact) ? "_blank" : null)"
                           rel="@(IsExternal(contact) ? "noopener noreferrer" : null)">
                            <span class="contact__label">@contact.Label</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private Profile? profile;

    protected override async Task OnInitializedAsync()
    {
        profile = await Content.GetProfileAsync();
    }

    private static bool IsExternal(ContactLink contact)
        => !contact.Url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase);
}
