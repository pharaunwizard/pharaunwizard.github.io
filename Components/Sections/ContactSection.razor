@inject ContentService Content

<section class="section contacts" id="contacts" aria-labelledby="contacts-title">
    <div class="container">
        <h2 id="contacts-title" class="section__title">Контакты</h2>
        @if (profile is null)
        {
            <div class="skeleton contacts__skeleton" aria-hidden="true"></div>
        }
        else if (profile.Contacts.Count == 0)
        {
            <p class="empty-state">Контакты пока не указаны.</p>
        }
        else
        {
            <p class="contacts__intro">Открыт к предложениям и сотрудничеству. Свяжитесь удобным способом:</p>
            <ul class="contacts__list">
                @foreach (var contact in profile.Contacts)
                {
                    var isEmail = contact.Type.Equals("email", StringComparison.OrdinalIgnoreCase);
                    var isUnavailable = IsUnavailable(contact.Url);
                    <li class="contact contact--@contact.Type">
                        @if (isEmail)
                        {
                            <span class="contact__link contact__link--static" data-type="@contact.Type">
                                <ContactIcon Type="@contact.Type" />
                                <span class="contact__label">@contact.Label:</span>
                                <span class="contact__value">@EmailAddress(contact)</span>
                            </span>
                        }
                        else if (isUnavailable)
                        {
                            <button type="button" class="contact__link" data-type="@contact.Type" @onclick="() => hhUnavailable = true">
                                <ContactIcon Type="@contact.Type" />
                                <span class="contact__label">@contact.Label</span>
                            </button>
                        }
                        else
                        {
                            <a class="contact__link" href="@contact.Url" data-type="@contact.Type" target="_blank" rel="noopener noreferrer">
                                <ContactIcon Type="@contact.Type" />
                                <span class="contact__label">@contact.Label</span>
                            </a>
                        }
                    </li>
                }
            </ul>
            @if (hhUnavailable)
            {
                <p class="contacts__notice" role="status">Резюме на hh.ru пока недоступно</p>
            }
        }
    </div>
</section>

@code {
    private Profile? profile;
    private bool hhUnavailable;

    protected override async Task OnInitializedAsync()
    {
        profile = await Content.GetProfileAsync();
    }

    private static string EmailAddress(ContactLink contact)
    {
        var url = contact.Url ?? string.Empty;
        return url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase)
            ? url["mailto:".Length..]
            : url;
    }

    private static bool IsUnavailable(string? url)
        => string.IsNullOrWhiteSpace(url);
}
